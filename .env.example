# Required: used implicitly by the OpenAI Agents SDK
OPENAI_API_KEY=

# Model used by all four agents
DEFAULT_MODEL_NAME=gpt-5.4-mini
# How many searches the planner is asked to produce
HOW_MANY_SEARCHES=5
# How many clarifying questions the clarifier asks before researching (max 3 are shown)
HOW_MANY_QUESTIONS=3

# Delivery: true = SMTP email, false = Pushover notification
USE_EMAIL=true
EMAIL_ADDRESS=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_APP_PASSWORD=

PUSHOVER_USER=
PUSHOVER_TOKEN=
